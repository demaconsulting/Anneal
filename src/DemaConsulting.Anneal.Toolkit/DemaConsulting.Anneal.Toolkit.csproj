<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Packaged as a .NET tool so that a repository restores it and invokes it as
    "dotnet anneal <action>". Nothing publishes it yet: the tool manifest that
    makes it restorable downstream is stage S2 of MIGRATION.md, so the package
    identity is fixed here only to stop it moving once something depends on it.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>anneal</ToolCommandName>
    <PackageId>DemaConsulting.Anneal.Toolkit</PackageId>
    <Description>Operations an AI coding agent cannot perform reliably by reading a prompt.</Description>

    <!--
      The version the payload reports about itself. It is a development version
      deliberately: publishing is a separate act requiring the user, and until
      that act happens every build is honestly pre-release. What matters for
      TOOLKIT-09 is not which version this is but that there is exactly one, read
      back out of the built assembly rather than restated anywhere in source.
    -->
    <Version>0.1.0-dev</Version>
  </PropertyGroup>

  <!--
    Model access. Microsoft.Extensions.AI supplies only the message and tool
    transport types the seam carries; GitHub.Copilot.SDK is the single provider
    behind it, driven under the ambient Copilot account of the calling session
    with no token supplied by the Toolkit.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.1" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.8" />
  </ItemGroup>

  <!--
    Reading contracts and reading test results. Markdig parses the architecture
    documents as CommonMark rather than by line, which is what lets a clause body
    wrap and keeps a clause-shaped string inside a fenced example out of the live
    contract. DemaConsulting.TestResults reads the result files, detecting TRX or
    JUnit from the file itself; both replace hand-rolled parsers whose failure
    mode was to mis-report a contract while reporting success.
  -->
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="DemaConsulting.TestResults" Version="1.10.0" />
  </ItemGroup>

</Project>
