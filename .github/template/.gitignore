# .gitignore
# TODO: Adjust for your language/toolchain. This template covers C# and common tools.

# Build outputs
bin/
obj/
artifacts/

# .NET
*.user
*.suo
.vs/
*.slnx.user

# Python virtual environment
.venv/

# Node
node_modules/
/package-lock.json

# Generated build outputs (never committed)
**/generated/
mermaid-filter.err

# Agent logs
.agent-logs/

# Toolkit evidence: invocation records and model transcripts. Both quote repository
# content - a transcript carries the files a model was shown, a record the arguments
# it was given - so neither is ever committed. The role configuration beside them is.
.anneal/records/
.anneal/transcripts/

# OS
.DS_Store
Thumbs.db
